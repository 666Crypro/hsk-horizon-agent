# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# Agent hot key: only needs gas (a few HSK). It can trade inside the vault policy and nothing else.
AGENT_PK=
# Optional: owner key lets the chat also pause/unpause on-chain. Prefer a hardware wallet for the owner.
OWNER_PK=
# Optional: any funded key to run the permissionless keeper (defaults to AGENT_PK)
KEEPER_PK=
# Which deployment to drive (see deployments/)
DEPLOYMENT=deployments/hsk-mainnet.json
# RPC override
RPC_URL=https://mainnet.hsk.xyz
# Optional LLM risk officer + free-form chat (any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
